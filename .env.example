# Copy to .env.local for local development. Never commit real values.

# next-auth
NEXTAUTH_URL=http://localhost:3000
# openssl rand -base64 32
NEXTAUTH_SECRET=

# shipment-api (see kestrelfreight/shipment-api)
SHIPMENT_API_URL=http://localhost:8000
# Service token issued by shipment-api for the portal (scope: portal)
SHIPMENT_API_TOKEN=
SHIPMENT_API_TIMEOUT_MS=8000

# Optional: enables the live map on public tracking pages
NEXT_PUBLIC_MAPBOX_TOKEN=
